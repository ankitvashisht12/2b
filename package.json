{
  "name": "2b",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test --test-concurrency=1 test/*.test.ts",
    "start": "./bin/2b start",
    "dev": "./bin/2b dash",
    "build": "tsc -p dash-v3 --noEmit && vite build --config dash-v3/vite.config.ts",
    "build:site": "tsc -p site --noEmit && vite build --config site/vite.config.ts",
    "dev:site": "vite --config site/vite.config.ts",
    "check": "tsc --noEmit && tsc -p dash-v3 --noEmit && node --experimental-strip-types --no-warnings scripts/check-v3.ts",
    "test:v3": "node --experimental-strip-types --no-warnings --test test/v3-*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "node --experimental-strip-types --no-warnings scripts/test-browser-v3.ts",
    "test:graph": "node --experimental-strip-types --no-warnings scripts/test-graph-v3.ts"
  },
  "version": "3.0.0",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
